generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DocumentStatus {
  UPLOADING
  QUARANTINED
  REJECTED
  READY_FOR_EXTRACTION
  PROCESSING
  COMPLETED
  FAILED
  DELETE_PENDING
  DELETED
}

enum RetentionPolicy {
  SESSION
  SEVEN_DAYS
  THIRTY_DAYS
  NINETY_DAYS
}

enum SecurityEventType {
  ACCOUNT_INITIALIZED
  PRIVACY_UPDATED
  DATA_EXPORTED
  ACCOUNT_DELETED
}

enum ActorMode {
  local
  oidc
}

enum CleanupReason {
  USER_DELETE
  ACCOUNT_DELETE
  RETENTION_EXPIRED
  REJECTED_UPLOAD
}

enum CleanupState {
  PENDING
  LEASED
  SUCCEEDED
}

model Owner {
  id        String     @id
  account   Account?
  documents Document[]
  createdAt DateTime   @default(now())
}

model Account {
  ownerId         String          @id
  owner           Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  subject         String
  retentionPolicy RetentionPolicy @default(SESSION)
  consentAccepted Boolean         @default(false)
  consentVersion  String?
  consentedAt     DateTime?
  deletionRequestedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  securityEvents  SecurityEvent[]
}

model Document {
  id                String         @id @default(uuid()) @db.Uuid
  ownerId           String
  owner             Owner          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title             String         @db.VarChar(180)
  sourceText        String
  contentHash       String         @db.Char(64)
  activeContentHash String?        @db.Char(64)
  status            DocumentStatus
  storageKey        String?        @db.VarChar(160)
  originalFilename  String?        @db.VarChar(180)
  declaredMime      String?        @db.VarChar(100)
  detectedMime      String?        @db.VarChar(100)
  byteSize          Int?
  scanResult        String?        @db.VarChar(20)
  rejectionCode     String?        @db.VarChar(80)
  extractionArtifact Json?
  extractionFailure Json?
  extractionAttempts Int           @default(0)
  extractionLeaseId String?        @db.Uuid
  extractionLeaseExpiresAt DateTime?
  retentionExpiresAt DateTime?
  cleanupTasks      StorageCleanupTask[]
  analysis          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([ownerId, activeContentHash])
  @@index([ownerId, status, createdAt])
  @@index([status, extractionLeaseExpiresAt])
  @@index([retentionExpiresAt, status])
}

model StorageCleanupTask {
  id              String        @id @default(uuid()) @db.Uuid
  ownerId         String
  documentId      String?       @db.Uuid
  document        Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  objectKey       String        @db.VarChar(160)
  reason          CleanupReason
  state           CleanupState  @default(PENDING)
  attempts        Int           @default(0)
  nextAttemptAt   DateTime      @default(now())
  leaseId         String?       @db.Uuid
  leaseExpiresAt  DateTime?
  lastErrorCode   String?       @db.VarChar(80)
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([documentId, objectKey, reason])
  @@index([state, nextAttemptAt])
  @@index([ownerId, state])
}

model SecurityEvent {
  sequence   BigInt            @id @default(autoincrement())
  id         String            @unique @default(uuid()) @db.Uuid
  ownerId    String
  account    Account           @relation(fields: [ownerId], references: [ownerId], onDelete: Cascade)
  type       SecurityEventType
  occurredAt DateTime          @default(now())
  actorMode  ActorMode

  @@index([ownerId, sequence])
}
