NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CORS_ORIGIN=http://localhost:3000
MAX_TEXT_CHARACTERS=250000
# Memory persistence is for local development and tests only. Production requires postgresql.
MAX_UPLOAD_BYTES=10000000
# Local/test uploads remain in memory. Production requires a private HTTPS S3-compatible endpoint and explicit scanner mode.
STORAGE_MODE=memory
# S3_ENDPOINT=https://object-storage.example
# S3_BUCKET=lexilens-private-quarantine
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=change-me
# S3_SECRET_ACCESS_KEY=change-me
# SCANNER_MODE=magic
PERSISTENCE_MODE=memory
# Required when PERSISTENCE_MODE=postgresql. Never commit a real credential.
# DATABASE_URL=postgresql://lexilens:change-me@localhost:5432/lexilens?schema=public
# Local mode is development-only. Production configuration fails closed unless this is oidc.
AUTH_MODE=local
# OIDC_ISSUER_URL=https://your-tenant.auth0.com/
# OIDC_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json
# OIDC_AUDIENCE=https://api.lexilens.example
ENABLE_HEALTHCARE_ANALYSIS=false
# Extraction is worker-requested; upload never parses automatically. Local/test native text is bounded and OCR is deliberately disabled.
EXTRACTION_MAX_CHARACTERS=250000
EXTRACTION_MAX_PAGES=100
EXTRACTION_TIMEOUT_MS=10000
EXTRACTION_LEASE_MS=60000
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_RECONCILIATION_BATCH_SIZE=100
# OCR defaults to deterministic disabled mode (no network or credentials). `configured` validates deployment-injected endpoint/credential but no vendor adapter is bundled.
OCR_MODE=disabled
# OCR_PROVIDER_ENDPOINT=https://approved-ocr.example/extract
# OCR_PROVIDER_CREDENTIAL=deployment-injected-secret
# Production must run a real queue/scheduler that invokes the internal worker/reconciliation service; the guarded route only returns safe status/count metadata. No real vendor, parser, queue, or scheduler is bundled.

# Browser public configuration. These NEXT_PUBLIC values are intentionally visible in the browser; never put a client secret, token, verifier, or private credential here.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Local is only for loopback development. `next build` production mode requires oidc and all values below.
NEXT_PUBLIC_AUTH_MODE=local
# Register an OIDC public SPA application with Authorization Code + PKCE (S256), no client secret, and exact redirect/logout URLs.
# NEXT_PUBLIC_OIDC_ISSUER=https://your-tenant.auth.example/
# NEXT_PUBLIC_OIDC_CLIENT_ID=your-public-spa-client-id
# NEXT_PUBLIC_OIDC_REDIRECT_URI=https://app.lexilens.example/auth/callback
# NEXT_PUBLIC_OIDC_POST_LOGOUT_URI=https://app.lexilens.example/
# NEXT_PUBLIC_OIDC_AUDIENCE=https://api.lexilens.example
# NEXT_PUBLIC_OIDC_SCOPE=openid profile documents:read documents:write
