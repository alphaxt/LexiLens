NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CORS_ORIGIN=http://localhost:3000
MAX_TEXT_CHARACTERS=250000
# Local mode is development-only. Production configuration fails closed unless this is oidc.
AUTH_MODE=local
# OIDC_ISSUER_URL=https://your-tenant.auth0.com/
# Set this from the provider's OpenID discovery document `jwks_uri` value.
# OIDC_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json
# OIDC_AUDIENCE=https://api.lexilens.example
# Set to true only after required PHI compliance controls and agreements are in place.
ENABLE_HEALTHCARE_ANALYSIS=false
