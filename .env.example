NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CORS_ORIGIN=http://localhost:3000
MAX_TEXT_CHARACTERS=250000
# Memory persistence is for local development and tests only. Production requires postgresql.
MAX_UPLOAD_BYTES=10000000
# Local/test uploads remain in memory. Production requires a private HTTPS S3-compatible endpoint and explicit scanner mode.
STORAGE_MODE=memory
# S3_ENDPOINT=https://object-storage.example
# S3_BUCKET=lexilens-private-quarantine
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=change-me
# S3_SECRET_ACCESS_KEY=change-me
# SCANNER_MODE=magic
PERSISTENCE_MODE=memory
# Required when PERSISTENCE_MODE=postgresql. Never commit a real credential.
# DATABASE_URL=postgresql://lexilens:change-me@localhost:5432/lexilens?schema=public
# Local mode is development-only. Production configuration fails closed unless this is oidc.
AUTH_MODE=local
# OIDC_ISSUER_URL=https://your-tenant.auth0.com/
# OIDC_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json
# OIDC_AUDIENCE=https://api.lexilens.example
ENABLE_HEALTHCARE_ANALYSIS=false
# Extraction is worker-requested; upload never parses automatically. Local/test native text is bounded and OCR is deliberately disabled.
EXTRACTION_MAX_CHARACTERS=250000
EXTRACTION_MAX_PAGES=100
EXTRACTION_TIMEOUT_MS=10000
EXTRACTION_LEASE_MS=60000
OCR_MODE=disabled
# Production must run a real queue/scheduler that calls POST /documents/:id/extraction with documents:write (or an extraction scope), and configure a reviewed parser/OCR provider separately.
